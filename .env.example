# ==============================================================================
# CONFIGURAÇÕES DE AMBIENTE - PROJETO INTEGRADOR V-B (INTEGRA ENGENHARIA)
# Copie este arquivo para .env e preencha o seu APIFY_API_TOKEN
# ==============================================================================

# Autenticação Apify (Obrigatório para coleta real)
APIFY_API_TOKEN=

# Identificadores oficiais dos Actors verificados na Apify Store
# YouTube: streamers/youtube-scraper (ou automation-lab/youtube-scraper)
APIFY_YOUTUBE_ACTOR_ID=streamers/youtube-scraper
# Alternativa complementar para comentários de vídeos do YouTube:
APIFY_YOUTUBE_COMMENTS_ACTOR_ID=streamers/youtube-comments-scraper

# Instagram: apify/instagram-scraper (ou apify/instagram-hashtag-scraper)
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper

# Reddit: trudax/reddit-scraper-lite (ou automation-lab/reddit-scraper)
APIFY_REDDIT_ACTOR_ID=trudax/reddit-scraper-lite

# Limites de coleta por palavra-chave / execução (Controle de créditos gratuitos)
YOUTUBE_MAX_ITEMS=10
YOUTUBE_MAX_COMMENTS=5
INSTAGRAM_MAX_ITEMS=10
REDDIT_MAX_ITEMS=10
REDDIT_MAX_COMMENTS=5

# Timeout e retentativas da API Apify
APIFY_TIMEOUT_SECONDS=180
APIFY_MAX_RETRIES=3
APIFY_RETRY_BACKOFF_SECONDS=5

# Palavras-chave de pesquisa separadas por vírgula
SEARCH_KEYWORDS=Sistema ERP,Software de gestão empresarial,Implantação de ERP,Suporte técnico de sistemas,Dificuldades com ERP,Automação empresarial

# Configurações Apache Hadoop / HDFS e Apache Hive (Sem Docker)
HDFS_BASE_DIR=/projeto_integrador
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_DATABASE=integra_mercado
